{
  "name": "qaautomation",
  "version": "1.0.0",
  "description": "QA automation framework using Playwright and TypeScript",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test tests/api",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:negative": "playwright test --grep @negative",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report artifacts/playwright-report",
    "codegen": "playwright codegen",
    "test:html": "playwright test --reporter=html",
    "test:postman": "npx newman run \"projects/practiceQA/postman/collections/PracticeQA - API Testing.postman_collection.json\" -e \"projects/practiceQA/postman/environments/PracticeQA Environment.postman_environment.json\" -r htmlextra"
  },
  "keywords": [
    "playwright",
    "testing",
    "qa",
    "automation",
    "e2e",
    "api-testing"
  ],
  "author": "Cirley Nava",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "dotenv": "^17.4.2",
    "newman": "^6.2.3",
    "newman-reporter-htmlextra": "^1.23.1",
    "typescript": "^7.0.2"
  }
}